y = "Annual co2 (Billions of Metric Tonnes)")
# Plot for historical/total co2
ggplot(carbi,
aes(x = year,
y = hist_co2,
color = country)) +
geom_point() +
geom_path() +
theme_bw() +
labs(title = "Cumulative co2 Emissions in 5 Countries",
x = "Year",
y = "Cumulative co2 (Billions of Metric Tonnes)")
# Plot for co2 percap
ggplot(carbi,
aes(x = year,
y = co2_Percap,
color = country)) +
geom_point() +
geom_path() +
theme_bw() +
labs(title = "co2 Emissions Per Capita in 5 Countries",
x = "Year",
y = "co2 Per Capita (Metric Tonnes)")
# Plot for change in Population and Cumulative co2 in 5 Countries
ggplot(year0,
aes(x = year,
y = pop,
color = country)) +
geom_point() +
geom_path() +
theme_bw() +
labs(title = "Change in GDP and co2 Emissions Per Capita in 5 Countries",
x = "GDP",
y = "co2 Emissions")
###########################################################
# Set up a table for average annual emissions for 5 select countries
Annual_Emissions <- carbi %>%
select(country, co2) %>%
group_by(country) %>%
summarize(mean_co2 = mean(co2,
na.rm=TRUE)) %>%
arrange(desc(mean_co2))
View(Annual_Emissions)
