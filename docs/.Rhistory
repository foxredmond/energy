#Bootcamp Exam 1
#Load Libraries
library(dplyr)
library(ggplot2)
library(readr)
url <- 'https://nyc3.digitaloceanspaces.com/owid-public/data/co2/owid-co2-data.csv'
carbon <-
read_csv(url) %>%
select(country,
year,
pop = population,
gdp,
co2,
hist_co2 = cumulative_co2)
###########################################################
#Data Exploration
View(carbon)
carbon %>% ncol
carbon %>% nrow
carbon %>% names
carbon %>% glimpse
carbon %>% pull(year) %>% range
carbon %>% pull(country) %>% unique
carbon %>% head
carbon %>% tail
###########################################################
#Make variable 'carbi' a subset of data with 5 select countries
carbi <-
carbon %>%
filter(country %in% c('United States', 'China', 'India', 'Russia', 'Brazil')) %>%
# Make co2 & cumulative co2 in units of Billions of Tonnes
mutate(co2 = co2/1000) %>%
mutate(hist_co2 = hist_co2/1000) %>%
mutate(pop = pop/1000000) %>%
# Make co2 / capita and set it in units of Thousands of Tonnes per person
mutate(co2_Percap = (co2 * 1000000000) / pop)
year0 <- carbi %>% filter(year >= 1850)
View(carbi)
###########################################################
# Plot for annual co2
ggplot(carbi,
aes(x = year,
y = co2,
color = country)) +
geom_point() +
geom_path() +
theme_bw() +
labs(title = "Annual co2 Emissions in 5 Countries",
x = "Year",
y = "Annual co2 (Billions of Metric Tonnes)")
# Plot for historical/total co2
ggplot(carbi,
aes(x = year,
y = hist_co2,
color = country)) +
geom_point() +
geom_path() +
theme_bw() +
labs(title = "Cumulative co2 Emissions in 5 Countries",
x = "Year",
y = "Cumulative co2 (Billions of Metric Tonnes)")
# Plot for co2 percap
ggplot(carbi,
aes(x = year,
y = co2_Percap,
color = country)) +
geom_point() +
geom_path() +
theme_bw() +
labs(title = "co2 Emissions Per Capita in 5 Countries",
x = "Year",
y = "co2 Per Capita (Metric Tonnes)")
# Plot for change in Population and Cumulative co2 in 5 Countries
